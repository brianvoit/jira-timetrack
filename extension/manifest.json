{
  "manifest_version": 2,
  "name": "Jira Time Helper",
  "version": "1.7",
  "description": "Extracts Jira issue details and uses AI to generate a clean time entry summary.",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icons/icon48.png" },
    "default_title": "Jira Time Helper"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jira-time-helper@brianvoit",
      "strict_min_version": "109.0",
      "update_url": "https://raw.githubusercontent.com/brianvoit/jira-timetrack/main/updates.json"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "tabs",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/browse/*",
        "*://*.atlassian.net/jira/*",
        "*://*/browse/*",
        "*://*/jira/browse/*",
        "*://*/secure/RapidBoard.jspa*",
        "*://*/jira/software/*/boards/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
