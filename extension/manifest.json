{
  "manifest_version": 2,
  "name": "Jira Time Helper",
  "version": "3.3",
  "description": "Starts the right pm.plaudit.com timer from a Jira ticket or a client email in Gmail, with an AI-written note.",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    },
    "default_title": "Jira Time Helper"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jira-time-helper@brianvoit",
      "strict_min_version": "109.0",
      "update_url": "https://raw.githubusercontent.com/brianvoit/jira-timetrack/main/updates.json"
    }
  },
  "background": {
    "scripts": [
      "lib/jira.js",
      "lib/ai.js",
      "lib/pm.js",
      "background.js"
    ],
    "persistent": false
  },
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "clipboardWrite",
    "storage",
    "tabs",
    "https://pm.plaudit.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/browse/*",
        "*://*.atlassian.net/jira/*",
        "*://*/browse/*",
        "*://*/jira/browse/*",
        "*://*/secure/RapidBoard.jspa*",
        "*://*/jira/software/*/boards/*",
        "*://*/projects/*/issues/*"
      ],
      "js": [
        "lib/jira.js",
        "lib/widget.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "lib/widget.js",
        "gmail.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
